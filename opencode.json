{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "linear": {
      "type": "local",
      "command": ["npx", "-y", "mcp-remote", "https://mcp.linear.app/mcp"],
      "enabled": true
    },
    "servers": {
      "mercadopago": {
        "type": "remote",
        "url": "https://mcp.mercadopago.com/mcp",
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {env:MERCADOPAGO_ACCESS_TOKEN}"
        }
      }
    }
  }
}
