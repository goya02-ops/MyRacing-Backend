# JWT Secrets - REEMPLAZAR ESTOS VALORES EN PRODUCCION
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=REEMPLAZAR_CON_SECRET_REAL_MINIMO_32_CARACTERES
JWT_REFRESH_SECRET=REEMPLAZAR_CON_REFRESH_SECRET_REAL_MINIMO_32_CARACTERES

# Entorno: development | production
NODE_ENV=development